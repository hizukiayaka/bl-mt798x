+		.cmd = "mtkupgrade fip"
+	},
+#ifdef CONFIG_MTK_FIP_SUPPORT
+	{
+		.desc = "  Upgrade ATF BL31 only",
+		.cmd = "mtkupgrade bl31"
+	},
+	{
+		.desc = "  Upgrade bootloader only",
+		.cmd = "mtkupgrade bl33"
