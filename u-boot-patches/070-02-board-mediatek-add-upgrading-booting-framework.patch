+		return -EBADMSG;
+	}
+
+	if (size > fip_part_size) {
+		cprintln(ERROR, "*** Invalid image size (0x%lx) ***", size);
+		return -EINVAL;
+	}
+
+	ret = fip_update_uboot_data(data, size, buf, fip_part_size,
+				    &new_fip_size, buf_size);
+	if (ret) {
