+obj-$(CONFIG_MTK_FSEK) += mtk_sec_env.o
+obj-$(CONFIG_MTK_FSEK) += mtk_fsek.o
diff --git a/board/mediatek/common/autoboot_helper.h b/board/mediatek/common/autoboot_helper.h
new file mode 100644
index 0000000000..969321ee0d
--- /dev/null
+++ b/board/mediatek/common/autoboot_helper.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (C) 2021 MediaTek Inc. All Rights Reserved.
+ *
+ * Author: Weijie Gao <weijie.gao@mediatek.com>
+ *
+ * Generic autoboot menu helper
+ */
+
+#ifndef _AUTOBOOT_HELPER_H_
+#define _AUTOBOOT_HELPER_H_
+
+#include <linux/types.h>
+#include <stdbool.h>
+
