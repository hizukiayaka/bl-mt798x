+	ret = _mmc_find_part(mmc, part_name, &dpart);
+	if (ret)
+		return ret;
+
+	if (!size)
+		size = (u64)dpart.size * dpart.blksz;
+
+	return _mmc_erase_env(mmc, (u64)dpart.start * dpart.blksz, size);
+}
