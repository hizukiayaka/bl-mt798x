diff --git a/include/failsafe.h b/include/failsafe.h
new file mode 100644
index 0000000000..ee23c1a1e1
--- /dev/null
+++ b/include/failsafe.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+
+#ifndef _FAILSAFE_H_
+#define _FAILSAFE_H_
+
+typedef enum {
+	FW_TYPE_GPT,
+	FW_TYPE_BL2,
+	FW_TYPE_FIP,
+	FW_TYPE_FW_LEGACY,
+	FW_TYPE_ITB_FW,
+} failsafe_fw_t;
+
+#endif
